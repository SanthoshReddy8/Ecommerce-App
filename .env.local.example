# Database (Docker: docker compose up -d)
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5432/ecommerce"

# NextAuth — set AUTH_URL to whatever port `npm run dev` starts on
AUTH_SECRET="generate-a-32-char-secret-here"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Payment provider: "razorpay" (default) or "stripe"
PAYMENT_PROVIDER="razorpay"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"

# Notification channels: "email" or "email,whatsapp"
NOTIFICATION_CHANNELS="email"

# SMTP — Mailhog default (docker compose up -d)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="store@ecommerce.local"

# Admin login credentials (seeded via npm run db:seed)
ADMIN_EMAIL="admin@store.com"
ADMIN_PASSWORD="changeme"

# Reservation TTLs (minutes)
CART_RESERVATION_TTL_MINUTES="15"
CHECKOUT_RESERVATION_TTL_MINUTES="30"
COUPON_RESERVATION_TTL_MINUTES="30"
